rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /products/{document=**} { allow read: if true; allow write: if false; }
    match /productVariants/{document=**} { allow read: if true; allow write: if false; }
    match /providers/{document=**} { allow read, write: if false; }
    match /users/{userId} { allow read, create, update: if isOwner(userId); allow delete: if false; }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
